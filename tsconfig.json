{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": false,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node"],
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@dotpm/core": ["./vendor/obsidian-pm/packages/core/src/index.ts"],
      "@dotpm/api": ["./vendor/obsidian-pm/packages/api/src/index.ts"]
    }
  },
  "include": ["src", "test", "types", "tsup.config.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules", "vendor"]
}
